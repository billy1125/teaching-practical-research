# OS
.DS_Store
Thumbs.db   

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
conda-meta/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*

# Claude Code local settings（含 MCP API key，不可進版控）
.claude/settings.local.json

# Editors
.vscode/
.idea/
*.swp

# Temp
*.tmp
*~

# 文件檔
*.docx
*.pdf

# 作者個人寫作風格素材與蒸餾結果不進版控，僅保留空資料夾
writing-style/*
!writing-style/.gitkeep

# 各計畫資料夾（drafts/<計畫資料夾>/）屬個人資料，預設不進版控，只保留範本
drafts/*
!drafts/.gitkeep
!drafts/_template/
